# Local filesystem + SQLite configuration
# Paths are relative to the project root unless absolute.

SQLITE_PATH=
STORAGE_ROOT=
AN_SVC_URL=localhost:10666
PII_SCORE_THRESHOLD=0.6
SPACY_MODEL=en_core_web_sm

# --- Authentication (JWT) ---
# REQUIRED for stable logins. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Kafka (scan job queue; start the broker with: docker compose up -d) ---
# Set KAFKA_ENABLED=0 to scan inside the upload request instead (no broker, no worker needed).
KAFKA_ENABLED=1
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCAN_TOPIC=pii-scan-jobs
KAFKA_GROUP_ID=pii-scan-workers
